<div class="pj-panel">
  <section class="pj-group">
    <h3>{{localize 'PJ.Prefs.Layout'}}</h3>
    <div class="pj-seg" role="group" aria-label="{{localize 'PJ.Prefs.Layout'}}">
      <button type="button" data-action="setLayout" data-layout="classic" aria-pressed="{{isClassic}}">{{localize 'PJ.Prefs.LayoutClassic'}}</button>
      <button type="button" data-action="setLayout" data-layout="camp" aria-pressed="{{isCamp}}" {{#unless campEnabled}}disabled{{/unless}}>{{localize 'PJ.Prefs.LayoutCamp'}}</button>
    </div>
    {{#unless campEnabled}}<p class="pj-hint">{{localize 'PJ.Prefs.LayoutCampSoon'}}</p>{{/unless}}
  </section>

  <section class="pj-group">
    <h3>{{localize 'PJ.Prefs.Theme'}}</h3>
    <button type="button" class="pj-toggle" data-action="toggleTheme" aria-pressed="{{themeOn}}">
      <img src="{{emblem}}" alt="" width="30" height="30">
      <span class="pj-toggle-text">
      <strong>{{localize 'PJ.Prefs.ThemeToggle'}}: {{themeLabel}}</strong>
      <small>{{localize 'PJ.Prefs.ThemeHint'}}</small>
      </span>
      <span class="pj-state">{{#if themeOn}}{{localize 'PJ.Prefs.On'}}{{else}}{{localize 'PJ.Prefs.Off'}}{{/if}}</span>
    </button>
  </section>

  <section class="pj-group">
    <h3>{{localize 'PJ.Prefs.QuickRoll'}}</h3>
    <button type="button" class="pj-toggle" data-action="toggleQuickRoll" aria-pressed="{{quickRollOn}}">
      <i class="fa-solid fa-dice-d20 pj-toggle-icon" aria-hidden="true"></i>
      <span class="pj-toggle-text">
        <strong>{{localize 'PJ.Prefs.QuickRollTitle'}}</strong>
        <small>{{localize 'PJ.Prefs.QuickRollHint'}}</small>
      </span>
      <span class="pj-state">{{#if quickRollOn}}{{localize 'PJ.Prefs.On'}}{{else}}{{localize 'PJ.Prefs.Off'}}{{/if}}</span>
    </button>
  </section>

  <footer class="pj-footer">
    <button type="button" class="pj-reset" data-action="reset"><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize 'PJ.Prefs.Reset'}}</button>
    <span class="pj-version">{{localize 'PJ.Prefs.Version'}} {{version}}</span>
  </footer>
</div>
